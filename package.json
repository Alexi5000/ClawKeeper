{
  "name": "clawkeeper",
  "version": "2.0.3",
  "description": "OpenClaw-native finance agent infrastructure for SMB operations",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "packageManager": "bun@1.x",
  "scripts": {
    "predev": "bun run scripts/validate-config.ts",
    "dev": "bun run --watch src/index.ts",
    "prestart": "bun run scripts/validate-config.ts",
    "start": "bun run src/index.ts",
    "test": "node --test --import tsx $(find test tests -name '*.test.ts' | sort)",
    "test:unit": "node --test --import tsx $(find test tests -name '*.test.ts' | sort)",
    "fde:contracts": "tsx scripts/validate-fde-contracts.ts",
    "fde:test": "node --test --import tsx $(find tests/fde -name '*.test.ts' | sort)",
    "fde:benchmark": "tsx scripts/run-fde-benchmark.ts",
    "proof:v2": "tsx scripts/generate-proof-v2.ts",
    "proof:v2:validate": "tsx scripts/validate-proof-v2.ts",
    "quality": "npm run typecheck && npm run lint && npm run test",
    "docs:validate": "node scripts/validate-readme-localizations.mjs",
    "lint": "eslint src/ test/ tests/",
    "typecheck": "tsc --noEmit",
    "validate": "bun run scripts/validate-config.ts",
    "db:migrate": "psql $DATABASE_URL -f db/schema.sql",
    "db:migrations": "bash -lc 'for file in db/migrations/*.sql; do psql \"$DATABASE_URL\" -f \"$file\"; done'",
    "db:rls": "psql $DATABASE_URL -f db/rls.sql",
    "db:rbac": "psql $DATABASE_URL -f db/rbac.sql",
    "db:seed": "psql $DATABASE_URL -f db/seed.sql",
    "db:setup": "bun run db:migrate && bun run db:migrations && bun run db:rls && bun run db:rbac && bun run db:seed",
    "dashboard:dev": "cd dashboard && bun run dev",
    "dashboard:build": "cd dashboard && bun run build",
    "demo:download": "cd src/demo/download && pip install -r requirements.txt && python download_datasets.py",
    "demo:transform": "bun run src/demo/transform/index.ts",
    "demo:generate": "bun run src/demo/generate/index.ts",
    "demo:seed": "bun run src/demo/seed/index.ts",
    "demo:setup": "bun run demo:download && bun run demo:transform && bun run demo:generate && bun run demo:seed",
    "demo:quick": "bun run demo:transform && bun run demo:generate && bun run demo:seed",
    "demo:db": "bun run db:setup && bun run demo:quick",
    "demo:offline": "bun run demo:transform && bun run demo:generate && npm run proof:v2 && npm run proof:v2:validate",
    "demo:fixtures": "tsx src/demo/transform/index.ts && tsx src/demo/generate/index.ts",
    "demo:fixtures:verify": "node scripts/verify-demo-fixtures.mjs",
    "setup:demo": "bun run scripts/setup-demo.ts",
    "setup:full": "bun run scripts/full-setup.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.3",
    "hono": "^4.13.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^6.17.0",
    "opik": "^1.0.0",
    "postgres": "^3.4.5",
    "uuid": "^11.1.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^8.56.0",
    "tsx": "^4.23.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "openclaw",
    "agents",
    "ai",
    "finance-agent",
    "financial-operations",
    "automation",
    "invoices",
    "reconciliation",
    "financial-reporting",
    "finance-operations",
    "agent-infrastructure",
    "multi-tenant",
    "smb",
    "agentic-ai",
    "bun"
  ],
  "author": "ClawKeeper Contributors",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  }
}
